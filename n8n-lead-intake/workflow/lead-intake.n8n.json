    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.2, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: \"You classify a website lead for Northline Studio and write a two-line summary.\\n\\nReturn only JSON with the keys temperature, summary, and reason.\\ntemperature must be exactly one of: hot, warm, cold.\\n\\nRules, in order:\\n- Cold if the message says there is no budget, the person is just curious, or this is school research.\\n- Hot if they want to start this week, say urgent or ASAP, have a budget approved, are the decision maker, or ask for a call today.\\n- Warm if they ask about pricing, a quote, a demo, or a timeline that is not immediate.\\n- Otherwise warm when a company is present, and cold when it is not.\\n\\nsummary is exactly two lines, separated by one newline.\\nLine 1 says who they are and what they want, using only facts in the lead.\\nLine 2 states the temperature, the reason, and the next step (call today, send pricing, or nurture only).\\nDo not invent budget, authority, or timeline.\\nreason is one short sentence.\" }, { role: 'user', content: JSON.stringify({ name: $json.name, email: $json.email, company: $json.company, phone: $json.phone, source: $json.source, message: $json.message }) }] }) }",
        "options": {
          "timeout": 20000
        }
      },
      "id": "7c1e9a20-5555-4a11-8c11-555555555555",
      "name": "Classify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        280
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "OpenAI Authorization header"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const lead = $('Normalize Lead').first().json;\nconst body = $input.first().json;\nconst content = body.choices?.[0]?.message?.content;\nif (!content) {\n  throw new Error('OpenAI response did not include message content');\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(content);\n} catch (error) {\n  throw new Error(`OpenAI content was not JSON: ${content.slice(0, 180)}`);\n}\nconst temperature = String(parsed.temperature || '').toLowerCase();\nif (!['hot', 'warm', 'cold'].includes(temperature)) {\n  throw new Error(`Unexpected temperature: ${temperature}`);\n}\nconst summary = String(parsed.summary || '').trim();\nconst lines = summary.split(/\\n/).map((line) => line.trim()).filter(Boolean);\nif (lines.length !== 2) {\n  throw new Error('Summary must be exactly two lines');\n}\nreturn [{\n  json: {\n    ...lead,\n    temperature,\n    summary: lines.join('\\n'),\n    reason: String(parsed.reason || ''),\n    classifiedBy: 'openai',\n  },\n}];\n"
      },
      "id": "7c1e9a20-6666-4a11-8c11-666666666666",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        180
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const lead = $('Normalize Lead').first().json;\nconst HOT = [\"urgent\", \"asap\", \"as soon as possible\", \"this week\", \"ready to start\", \"ready to buy\", \"budget approved\", \"budget is approved\", \"decision maker\", \"call me today\", \"immediately\", \"signed off\"];\nconst WARM = [\"pricing\", \"price\", \"quote\", \"interested\", \"next month\", \"evaluating\", \"demo\", \"timeline\", \"comparing\"];\nconst COLD = [\"just curious\", \"just looking\", \"student\", \"no budget\", \"someday\", \"not sure\", \"maybe later\", \"researching for school\"];\nconst blob = `${lead.message || ''} ${lead.company || ''} ${lead.source || ''}`.toLowerCase();\nconst hits = (phrases) => phrases.filter((phrase) => blob.includes(phrase));\nlet temperature = 'cold';\nlet reason = 'There is no company and no clear buying signal.';\nif (blob.includes('no budget') || blob.includes('just curious') || blob.includes('researching for school')) {\n  temperature = 'cold';\n  reason = 'The note shows curiosity or no budget, so it is not a live opportunity.';\n} else if (hits(HOT).length) {\n  temperature = 'hot';\n  reason = `The note signals near-term intent (${hits(HOT)[0]}).`;\n} else if (hits(WARM).length) {\n  temperature = 'warm';\n  reason = `The note asks for information (${hits(WARM)[0]}) without a start-now signal.`;\n} else if (hits(COLD).length) {\n  temperature = 'cold';\n  reason = `The note is low intent (${hits(COLD)[0]}).`;\n} else if (lead.company) {\n  temperature = 'warm';\n  reason = 'A company is named, but the note does not say how soon they want to start.';\n}\nconst who = lead.company ? `${lead.name || 'Unknown sender'} at ${lead.company}` : (lead.name || 'Unknown sender');\nconst want = (lead.message || 'did not describe a project').replace(/\\s+/g, ' ').trim();\nconst shortWant = want.length > 110 ? `${want.slice(0, 107).trim()}...` : want;\nconst nextStep = { hot: 'call today', warm: 'send pricing', cold: 'nurture only' }[temperature];\nconst summary = `${who} wrote: ${shortWant}.\\n${temperature[0].toUpperCase()}${temperature.slice(1)} lead because ${reason} Next step: ${nextStep}.`;\nreturn [{ json: { ...lead, temperature, summary, reason, classifiedBy: 'rules-fallback' } }];\n"
      },
      "id": "7c1e9a20-7777-4a11-8c11-777777777777",
      "name": "Rules Fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        400
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst first = (item.name || 'there').split(' ')[0];\nconst bodies = {\n  hot: `Hi ${first},\\n\\nThanks for writing in. A specialist will call you today about the workflow you described.\\n\\nNorthline Studio`,\n  warm: `Hi ${first},\\n\\nThanks for your interest. Reply with two times that work for a 15-minute call, and we will send a short pricing outline before we meet.\\n\\nNorthline Studio`,\n  cold: `Hi ${first},\\n\\nThanks for getting in touch. If a workflow project comes up later, reply to this note and we will pick it up from there.\\n\\nNorthline Studio`,\n};\nconst subjects = {\n  hot: 'We got your note and will call today',\n  warm: 'Pricing next steps from Northline Studio',\n  cold: 'Thanks for contacting Northline Studio',\n};\nconst slackText = [\n  `*Hot lead:* ${item.name || 'Unknown'} \u00b7 ${item.company || 'No company'}`,\n  item.email,\n  item.phone || 'No phone',\n  '',\n  item.summary,\n  '',\n  `Source: ${item.source || 'website-form'}`,\n].join('\\n');\nreturn [{\n  json: {\n    ...item,\n    emailSubject: subjects[item.temperature] || subjects.warm,\n    emailBody: bodies[item.temperature] || bodies.warm,\n    slackText,\n    sheetTimestamp: new Date().toISOString(),\n  },\n}];\n"
      },
