{
  "name": "Northline Studio \u2014 Lead intake",
  "nodes": [
    {
      "parameters": {
        "content": "## Northline lead intake\n1. Website form posts to this webhook.\n2. OpenAI labels the lead hot, warm, or cold and writes a two-line summary.\n3. If OpenAI errors, the rules fallback uses the same phrases.\n4. Every valid lead is appended to Google Sheets and gets a Gmail reply.\n5. Hot leads also post in #hot-leads.\n\nReplace every REPLACE_ME credential and the sheet id before activating.",
        "height": 260,
        "width": 420,
        "color": 5
      },
      "id": "7c1e9a20-eeee-4a11-8c11-eeeeeeeeeeee",
      "name": "How this flow works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        40
      ]
    },
